{
  "name": "nextjs-electron-template",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js + Electron template",
  "author": "David Hazell",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron:dev": "electron . --dev",
    "electron:export": "cross-env ELECTRON=1 next build",
    "electron:start": "npm run electron:export && electron .",
    "electron:build": "npm run electron:export && electron-builder",
    "electron:build:win": "npm run electron:export && electron-builder --win --ia32"
  },
  "dependencies": {
    "animate.css": "^4.1.1",
    "classnames": "^2.5.1",
    "electron-serve": "^1.3.0",
    "electron-store": "^8.2.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sass": "^1.77.3"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^34.0.0",
    "electron-builder": "^24.13.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.0"
  }
}
